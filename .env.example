# Copy to .env for local development. Never commit .env.
# Every value here is a local-only placeholder, not a real credential.
# With no .env at all, `docker compose up` still works on these defaults.

POSTGRES_USER=paritylens
POSTGRES_PASSWORD=local-dev-only
POSTGRES_DB=paritylens

# --- API and worker (all optional locally) ---------------------------------

# PARITYLENS_ENVIRONMENT=local            # "production" refuses unsafe defaults
# PARITYLENS_DATABASE_URL=postgresql+asyncpg://paritylens:local-dev-only@localhost:5432/paritylens
# PARITYLENS_PUBLIC_BASE_URL=http://localhost:3000

# Sign-in. "dev" lets anyone sign in with any email address: local use only.
# PARITYLENS_AUTH_MODE=dev                # or "google"
# PARITYLENS_GOOGLE_CLIENT_ID=
# PARITYLENS_GOOGLE_CLIENT_SECRET=

# Key that encrypts stored secrets: 32 random bytes, base64.
# Generate one with: python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
# PARITYLENS_MASTER_KEY=

# What the hosted worker may connect to: permissive | public_only | allowlist
# PARITYLENS_EGRESS_MODE=permissive
# PARITYLENS_EGRESS_ALLOW_HOSTS=legacy-shop-api:8000,modern-shop-api:8000

# --- CLI upload ----------------------------------------------------------------

# PARITYLENS_API_URL=http://localhost:3000
# PARITYLENS_API_TOKEN=
